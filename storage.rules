rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Today's Supabase bucket is used as fully public (every URL is a public
    // URL, never signed) — same policy here: public read, owner-only write.
    match /artist-media/profile/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /artist-media/{artistUid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == artistUid;
    }
  }
}
