rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Artist profile photo — one per uid, publicly readable, only the
    // owner can write, images only, capped at 10MB.
    match /artist-media/profile/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Artist portfolio photos/videos — publicly readable, only the owner
    // can write, capped at 50MB (video).
    match /artist-media/{uid}/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Artist verification documents (Aadhaar, PAN, etc.) — sensitive, NOT
    // publicly readable unlike media above. Only the owning artist and
    // admin/coordinator (role set via Firebase Auth custom claims, same as
    // Firestore's rules) can read; only the owner can write.
    match /artist-documents/{uid}/{docId} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.role == 'admin' || request.auth.token.role == 'coordinator');
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
